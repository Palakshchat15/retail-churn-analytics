# Postgres
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=retail_analytics
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Airflow (uses its own metadata db inside the same postgres instance)
AIRFLOW_UID=50000

# GenAI provider preference order: GROQ_API_KEY > OPENAI_API_KEY > local Ollama > error (OPTIONAL step)
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Absolute path of this project on the host machine (forward slashes), e.g. C:/Users/you/Projects/retail_analytics_project
HOST_PROJECT_DIR=
